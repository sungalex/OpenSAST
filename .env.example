# OpenSAST 환경변수 예시 — 복사 후 값을 수정하세요

# 배포 프로파일: local | docker | cloud
# 프로파일은 "기본값 번들" 이다. 명시하지 않으면 local 로 동작해 CORS 가 "*",
# API docs 노출, rate limit 비활성 상태가 된다. 컨테이너/운영 배포에서는 반드시
# 지정한다. cloud 프로파일은 약한 시크릿이나 빈 CORS 로는 기동을 거부한다.
OPENSAST_PROFILE=local
OPENSAST_DEBUG=false

# CORS 허용 오리진 (콤마 구분). cloud 프로파일에서는 필수이며 "*" 는 거부된다.
# OPENSAST_CORS_ORIGINS=https://sast.example.com

# 데이터베이스
OPENSAST_DATABASE_URL=postgresql+psycopg2://opensast:opensast@localhost:5432/opensast

# Redis · Celery
OPENSAST_REDIS_URL=redis://localhost:6379/0
OPENSAST_CELERY_BROKER_URL=redis://localhost:6379/1
OPENSAST_CELERY_RESULT_BACKEND=redis://localhost:6379/2

# 파일 스토리지 — 업로드 소스/스캔 작업 디렉터리 (로컬 파일시스템)
# 기본값은 프로세스 CWD 기준 `<cwd>/.opensast-work` 이다.
# API 와 워커가 서로 다른 CWD 로 뜨면 같은 상대 경로가 다르게 해석되므로,
# 다중 프로세스 배포에서는 반드시 절대 경로로 명시한다.
# Docker 에서는 compose 가 /var/opensast-work 를 주입하고 호스트의
# ./.opensast-work 를 bind-mount 한다.
# OPENSAST_WORK_DIR=/var/opensast-work

# 경로 스캔(`POST /api/scans`) 으로 허용할 루트 디렉터리 (콤마 구분).
# 비워두면 OPENSAST_WORK_DIR 하나만 허용한다. 여기에 등록되지 않은 경로는
# 403 으로 거부되어, 워커 호스트의 임의 파일을 스캔·열람하는 경로를 막는다.
# OPENSAST_SCAN_ALLOWED_SOURCE_ROOTS=/var/opensast-work

# 인증
# JWT 서명 키. 아래 명령으로 생성해 채우세요:
#   openssl rand -hex 32
# 미설정 시 local/docker 프로파일은 임시 키를 자동 생성하고(재시작 시 토큰 무효,
# 다중 프로세스에서 세션 깨짐) cloud 프로파일은 기동을 거부합니다.
# OPENSAST_SECRET_KEY=
OPENSAST_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 최초 부트스트랩 관리자 — 운영 환경에서는 반드시 설정하세요.
# 미설정 시 admin@opensast.local / opensast-admin 로 생성되며,
# cloud 프로파일에서는 기본 비밀번호를 쓰면 기동을 거부합니다.
# OPENSAST_BOOTSTRAP_ADMIN_EMAIL=
# OPENSAST_BOOTSTRAP_ADMIN_PASSWORD=
OPENSAST_BOOTSTRAP_ADMIN_DISPLAY_NAME=OpenSAST Admin

# LLM
OPENSAST_LLM_PROVIDER=ollama         # ollama | anthropic | noop
OPENSAST_OLLAMA_HOST=http://localhost:11434
OPENSAST_OLLAMA_MODEL=gemma2:9b
OPENSAST_ANTHROPIC_API_KEY=
OPENSAST_ANTHROPIC_MODEL=claude-opus-4-6
# triage 동시 호출 수 (Ollama 단일 인스턴스는 2~4 권장) / 판정 상한 / 캐시 TTL
OPENSAST_LLM_MAX_CONCURRENCY=4
OPENSAST_TRIAGE_MAX_FINDINGS=2000
OPENSAST_TRIAGE_CACHE_TTL_SECONDS=86400

# 파이프라인 — 한 Pass 안에서 동시에 돌릴 엔진 수 (1 = 순차)
OPENSAST_ENGINE_MAX_CONCURRENCY=4

# 설정 오버레이 YAML (선택) — 환경변수보다 낮은 우선순위
# OPENSAST_OVERLAY_CONFIG=/etc/opensast/overlay.yaml

# 엔진 바이너리 경로 (PATH 에 있으면 그대로 사용)
OPENSAST_OPENGREP_BIN=semgrep
OPENSAST_BANDIT_BIN=bandit
OPENSAST_ESLINT_BIN=eslint
OPENSAST_GOSEC_BIN=gosec
OPENSAST_SPOTBUGS_BIN=spotbugs
OPENSAST_CODEQL_BIN=codeql
